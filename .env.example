# Ejemplo de variables de entorno para Atlas
# Copia este archivo como .env.local y completa los valores según tu entorno

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/atlas"

# URL de la aplicación (desarrollo o producción)
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://tudominio.vercel.app"

# Clave secreta para NextAuth
NEXTAUTH_SECRET="tu_clave_secreta"

# Configuración de Firebase (opcional, si usas autenticación o almacenamiento)
NEXT_PUBLIC_FIREBASE_API_KEY="tu_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu_auth_domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu_storage_bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="tu_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="tu_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="tu_measurement_id"
